{
  "schema_version": 1,
  "record_root": "~/teleop_data",
  "pc2_archive_root": "~/.local/share/xrcam_capture",
  "raw_storage": "pc2_rosbag2_verified_transfer",
  "sources": [["bag", 5603, 5605]],
  "pc2_bag_root": "~/.local/share/xrcam_bags",
  "bag_storage_id": "sqlite3",
  "bag_writer_binary": "~/xr_camera_teleoperation/data/bag-writer/xrcam_cdr_bag_writer",
  "dds_ipc": "ipc:///tmp/xrcam_dds_recording.sock",
  "record_end_effector_fk": false,
  "gesture_enabled": false,
  "ros2_bin": "/opt/ros/foxy/bin/ros2",
  "telemetry_host": "127.0.0.1",
  "bag_command_port": 5603,
  "bag_http_port": 5605,
  "state_names": [],
  "expected_rates_hz": {
    "/zed2i/zed_node/left/image_rect_color": 30,
    "/zed2i/zed_node/right/image_rect_color": 30,
    "/teleop/robot_state": 100,
    "/teleop/robot_action": 100
  },
  "state_age_limit_ms": 20.0,
  "action_age_limit_ms": 100.0,
  "pair_ratio_limit": 0.99,
  "robot_host": "192.168.123.164",
  "msi_host": "192.168.123.100",
  "dds_interface": "eth0",
  "dds_domain": 0,
  "record_hz": 100,
  "export_hz": 100,
  "prebuffer_seconds": 2,
  "gesture_hold_seconds": 1,
  "required_source_timeout_seconds": 2,
  "joint_reference_manifest": null,
  "state_action_order": "native_dds",
  "ros2": {
    "distro": "foxy",
    "required_image_topics": {
      "observation.images.cam_left_high": "/zed2i/zed_node/left/image_rect_color",
      "observation.images.cam_right_high": "/zed2i/zed_node/right/image_rect_color"
    },
    "camera_info_topics": [
      "/zed2i/zed_node/left/camera_info",
      "/zed2i/zed_node/right/camera_info"
    ],
    "robot_topics": ["/joint_states", "/lf/lowstate"],
    "optional_topics": [
      "/zed2i/zed_node/imu/data",
      "/zed2i/zed_node/imu/data_raw",
      "/zed2i/zed_node/imu/mag",
      "/zed2i/zed_node/left_cam_imu_transform",
      "/zed2i/zed_node/temperature/imu",
      "/zed2i/zed_node/temperature/left",
      "/zed2i/zed_node/temperature/right",
      "/zed2i/zed_node/pose",
      "/zed2i/zed_node/pose_with_covariance",
      "/zed2i/zed_node/odom",
      "/tf_static",
      "/camera/color/image_raw",
      "/camera/color/camera_info"
    ],
    "excluded_topic_prefixes": [
      "/zed2i/zed_node/depth/",
      "/zed2i/zed_node/disparity/",
      "/zed2i/zed_node/confidence/",
      "/zed2i/zed_node/point_cloud/"
    ]
  },
  "dds": {
    "required_state_topics": ["rt/lowstate", "rt/dex3/left/state", "rt/dex3/right/state"],
    "arm_command_candidates": ["rt/lowcmd", "rt/arm_sdk"],
    "required_hand_command_topics": ["rt/dex3/left/cmd", "rt/dex3/right/cmd"]
  },
  "operator": {"perception": "tcp://127.0.0.1:5590", "ee_cmd": "tcp://127.0.0.1:5591"},
  "export": {
    "automatic": false,
    "format": "lerobot_v3",
    "codec": "av1",
    "pixel_format": "yuv420p",
    "image_height": 480,
    "image_width": 640,
    "preserve_gestures": true,
    "keep_raw": true
  }
}
