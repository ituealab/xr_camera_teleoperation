# Kinematic live UI speed limits: arms 4 rad/s, hands 8 rad/s; requested pipeline 100 Hz.
# Source/use only when deliberately launching a new robot session; no running process is changed.
XRCAM_ARM_VEL_LIMIT=${XRCAM_ARM_VEL_LIMIT:-4.0}
XRCAM_HAND_VEL_LIMIT=${XRCAM_HAND_VEL_LIMIT:-8.0}
XRCAM_IK_HZ=${XRCAM_IK_HZ:-100}
XRCAM_OPERATOR_HZ=${XRCAM_OPERATOR_HZ:-100}
